@model IEnumerable<StudyGroup>

@{
    ViewData["Title"] = "My Groups";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Study Groups</h2>
        <a asp-action="Create" class="btn btn-success">+ New Group</a>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="row">
            @foreach (var group in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow">
                        <div class="card-body">
                            <h5 class="card-title">@group.Name</h5>
                            <p class="card-text text-muted">
                                <small>Created: @group.CreatedAt.ToString("dd.MM.yyyy")</small>
                            </p>

                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Members" asp-route-id="@group.Id" class="btn btn-sm btn-secondary">Members</a>
                            </div>

                            <div class="mt-2">
                                <a asp-controller="Schedule" asp-action="Index" asp-route-groupId="@group.Id" class="btn btn-sm btn-outline-primary">
                                    Schedule
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You don't have any groups yet. <a asp-action="Create">Create your first group</a>!
        </div>
    }
</div>
