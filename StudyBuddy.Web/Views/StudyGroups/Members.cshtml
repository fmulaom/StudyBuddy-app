@using StudyBuddy.Web.Models.ViewModels
@model GroupDetailsViewModel

@{
    ViewData["Title"] = "Group Members";
}

<div class="container mt-5">
    <h2>Group Members: @Model.Group.Name</h2>

    <div class="row mt-4">
        <div class="col-md-8">
            @if (Model.Members?.Count > 0)
            {
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>User ID</th>
                            <th>Role</th>
                            <th>Joined</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>@member.UserId</td>
                                <td><span class="badge bg-secondary">@member.Role</span></td>
                                <td>@member.JoinedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (member.Role != "Owner")
                                    {
                                        <form asp-action="RemoveMember" asp-route-groupId="@Model.Group.Id"
                                              asp-route-userId="@member.UserId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure?')">
                                                Remove
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">No members in the group.</div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">➕ Add Member</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddMember" asp-route-groupId="@Model.Group.Id" method="post">
                        <div class="mb-3">
                            <label for="UserId" class="form-label">User ID</label>
                            <input type="text" name="userId" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label for="Role" class="form-label">Role</label>
                            <select name="role" class="form-select">
                                <option value="Member">Member</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Add</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Details" asp-route-id="@Model.Group.Id" class="btn btn-secondary">Back to Details</a>
    </div>
</div>
