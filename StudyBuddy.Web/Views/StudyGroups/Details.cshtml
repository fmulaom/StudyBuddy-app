@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <h2>@Model.Name</h2>
    <p class="text-muted">Group created: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Group Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Status:</strong> <span class="badge bg-success">@(Model.IsActive ? "Active" : "Inactive")</span></p>
                    <p><strong>Owner ID:</strong> @Model.OwnerId</p>

                    <div class="mt-3">
                        <a asp-action="Members" asp-route-id="@Model.Id" class="btn btn-info">Members</a>
                        <a asp-controller="Schedule" asp-action="Index" asp-route-groupId="@Model.Id" class="btn btn-warning">Schedule</a>
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="Members" asp-route-id="@Model.Id" class="d-block mb-2 btn btn-sm btn-outline-primary">
                        Manage Members
                    </a>
                    <a asp-controller="Schedule" asp-action="Create" asp-route-groupId="@Model.Id" class="d-block mb-2 btn btn-sm btn-outline-success">
                        Schedule New Session
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
