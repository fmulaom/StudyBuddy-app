<!DOCTYPE html>
@model IEnumerable<StudyBuddy.Web.Models.LearningGoal>

@{
    ViewData["Title"] = "Learning Goals";
}

<h2>Learning Goals</h2>

<p>
    <a class="btn btn-primary"
       asp-controller="LearningGoals"
       asp-action="Create">
        Add new goal
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Target date</th>
            <th>Progress</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Title</td>
                <td>@g.TargetDate.ToShortDateString()</td>
                <td>@g.Progress %</td>
                <td>
                    <a class="btn btn-sm btn-secondary"
                       asp-action="Edit"
                       asp-route-id="@g.Id">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@g.Id"
                          method="post"
                          style="display:inline">
                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
