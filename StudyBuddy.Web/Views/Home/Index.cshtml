@model StudyBuddy.Web.Models.ViewModels.WeeklyCalendarViewModel

@{
    ViewData["Title"] = "Weekly Study Planner";

    var days = new[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}

<h2 class="mb-3">Weekly Study Planner</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    + Add task
</a>

<div class="row row-cols-1 row-cols-md-7 g-2">

    @foreach (var day in days)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-header fw-bold text-center">
                    @day
                </div>

                <div class="card-body p-2">

                    @if (Model.TasksByDay.ContainsKey(day))
                    {
                        foreach (var task in Model.TasksByDay[day])
                        {
                            <div class="border rounded p-2 mb-2">

                                <strong>@task.Title</strong>

                                <div class="small text-muted">
                                    @task.TaskType · @task.EstimatedMinutes min
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <div class="small mt-1">
                                        @task.Description
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">No tasks</small>
                    }

                </div>
            </div>
        </div>
    }

</div>
